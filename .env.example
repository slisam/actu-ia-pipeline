# Quatre clés Gemini, à garder exclusivement dans ce fichier local ignoré par Git.
# Vérifier le niveau Free et renseigner les identifiants de projets dans config.yaml.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Ancien fournisseur unique llm.provider=gemini, optionnel :
GEMINI_API_KEY=
# Option speech.provider=google : fichier ADC hors du dépôt
GOOGLE_APPLICATION_CREDENTIALS=
# Publication YouTube (scripts/authorize_youtube.py)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Instagram professionnel, droits de publication accordés à votre application Meta
IG_USER_ID=
IG_ACCESS_TOKEN=
# Hébergement public du MP4 pour Instagram : S3/R2 ou dossier servi par votre serveur
MEDIA_BASE_URL=
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_UPLOAD_DIR=
